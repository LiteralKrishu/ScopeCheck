# Set the exact origin used in the browser. Use HTTPS for a public deployment.
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Use a persistent Redis instance. Use rediss:// for managed TLS connections.
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth web client. Add AUTH_URL + /api/auth/callback/google in Google Cloud.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional passwordless email sign-in. Use a verified sender domain in Resend.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# Optional AI checks. Each request requires separate user consent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
